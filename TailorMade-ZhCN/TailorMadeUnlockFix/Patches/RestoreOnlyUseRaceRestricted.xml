<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Restore onlyUseRaceRestrictedApparel back to true for all HAR races.
    TailorMade's XML patch sets this to false unconditionally.
    We reverse that change here so HAR properly restricts alien races.

    The C# Harmony component reads the original XML files from disk to
    recover the deleted apparelList, then uses it to ALLOW confirmed items
    at runtime (overriding HAR's blanket rejection).
  -->

  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/AlienRace.ThingDef_AlienRace/alienRace/raceRestriction/onlyUseRaceRestrictedApparel[text()='false']</xpath>
    <value>
      <onlyUseRaceRestrictedApparel>true</onlyUseRaceRestrictedApparel>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[@Class="AlienRace.ThingDef_AlienRace"]/alienRace/raceRestriction/onlyUseRaceRestrictedApparel[text()='false']</xpath>
    <value>
      <onlyUseRaceRestrictedApparel>true</onlyUseRaceRestrictedApparel>
    </value>
  </Operation>

</Patch>
