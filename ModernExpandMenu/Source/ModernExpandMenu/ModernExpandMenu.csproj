<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ModernExpandMenu</AssemblyName>
    <RootNamespace>ModernExpandMenu</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ModernExpandMenuMod.cs" />
    <Compile Include="ModernExpandMenuSettings.cs" />
    <Compile Include="Patch_DisablePseudoTranslation.cs" />
    <Compile Include="Patch_Md3StyleAllInputs.cs" />
    <Compile Include="Patch_Md3StyleAllButtons.cs" />
    <Compile Include="Patch_Md3StyleMore.cs" />
    <Compile Include="Patch_SkipUploadDelay.cs" />
    <Compile Include="Patch_SpaceOnlyPause.cs" />
    <Compile Include="Patch_ModSettingsUI.cs" />
    <Compile Include="Patch_ItemGroupedFloatMenu.cs" />
    <Compile Include="ItemGrouping.cs" />
    <Compile Include="SettingsShare.cs" />
    <Compile Include="Theme\MD3Theme.cs" />
    <Compile Include="Theme\MiscTheme.cs" />
    <Compile Include="UI\Dialog_ResetDefaults.cs" />
    <Compile Include="UI\Dialog_ConfigManager.cs" />
    <Compile Include="UI\Dialog_RenameConfig.cs" />
    <Compile Include="UI\Dialog_MenuPreview.cs" />
    <Compile Include="UI\Dialog_MiscPreview.cs" />
    <Compile Include="UI\MD3Widgets.cs" />
    <Compile Include="UI\MD3FloatMenuWindow.cs" />
    <Compile Include="UI\MenuPreviewWidget.cs" />
    <Compile Include="UI\MiscPreviewWidget.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- RimWorld 引用 -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

  <!-- 构建后自动复制 DLL 到模组 Assemblies/ -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\..\Assemblies\" />
  </Target>
</Project>
