<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>NotificationsONWindowsNOW</AssemblyName>
    <RootNamespace>NotificationsOnWindowsNow</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NotificationsOnWindowsNowMod.cs" />
    <Compile Include="NotificationsOnWindowsNowSettings.cs" />
    <Compile Include="Dialog_ResetDefaults.cs" />
    <Compile Include="ToastBridgeClient.cs" />
    <Compile Include="ToastForwarder.cs" />
    <Compile Include="Patch_LetterStack_ReceiveLetter.cs" />
    <Compile Include="Patch_Messages_Message.cs" />
    <Compile Include="Theme\MD3Theme.cs" />
    <Compile Include="UI\MD3Widgets.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- RimWorld 与 Harmony 引用 -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

  <!-- 构建后自动复制到模组 Assemblies/ -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\..\Assemblies\" />
  </Target>
</Project>
